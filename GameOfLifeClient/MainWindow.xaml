<Window x:Class="GameOfLifeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameOfLifeClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <Label Content="Number of rows"/>
            <TextBox Text="{Binding RowAmount, Mode=TwoWay}"/>
            <Label Content="Number of columns"/>
            <TextBox Text="{Binding ColAmount, Mode=TwoWay}"/>
            <Label Content="test"/>
            <TextBox Text="{Binding CellPercentage, Mode=TwoWay}"/>
            <Button Content="Start" Command="{Binding StartCommand}" Margin="5"/>
        </StackPanel>
        <Image x:Name="GameImageDisplay" 
               Stretch="Uniform" 
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               Margin="20"
               Source="{Binding DisplayBitmap}"/>
    </Grid>
</Window>
